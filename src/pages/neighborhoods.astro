---
import Base from "../layouts/Base.astro";
import ContactButton from "../components/ContactButton.astro";

const neighborhoods = [
  {
    name: "Zilker",
    region: "Central Austin",
    image: "/neighborhood-zilker.jpg",
    description:
      "Nestled in the heart of Austin, Zilker is where natural beauty meets urban convenience. This sought-after neighborhood offers a vibrant blend of outdoor adventure, cultural events, and a lively community vibe.",
    housing:
      "A mix of sleek modern builds, charming bungalows, and luxurious condos with stunning views of the Austin skyline. Perfect for active individuals, families, and professionals who want the best of both worlds.",
    facts: ["Condos from $750K", "Single family homes from $1M", "AISD and nearby private schools"],
  },
  {
    name: "East Side",
    region: "East Austin",
    image: "/neighborhood-eastside.jpg",
    description:
      "Vibrant, eclectic, and full of energy, Austin's East Side is where creative culture meets urban living. This dynamic neighborhood is known for its artistic flair, rich history, and a welcoming community vibe.",
    housing:
      "A mix of stylish modern townhomes, restored historic properties, and contemporary condos with a unique edge. An ideal spot for young professionals, creatives, and families who value character and convenience.",
    facts: ["Condos from $500K", "Single family homes from $800K", "Vibrant nightlife"],
  },
  {
    name: "Seaholm District",
    region: "Downtown Austin",
    image: "/neighborhood-seaholm.jpg",
    description:
      "Modern, sleek, and effortlessly urban, the Seaholm District is Austin's premier downtown neighborhood. Known for its luxury high-rises, stunning skyline views, and vibrant energy, Seaholm offers an unmatched urban lifestyle.",
    housing:
      "Upscale condos, contemporary apartments, and exclusive penthouses. Perfect for professionals, executives, and anyone who wants to be at the center of Austin's cultural and business hub.",
    facts: ["Condos from $800K", "High-rise penthouses from $2M", "Walkable to top dining, shopping, and entertainment"],
  },
];
---

<Base
  title="Austin Neighborhood Guide | Sara + Kevin Russell"
  description="Explore Austin's best neighborhoods — Zilker, the East Side, the Seaholm District, and more — with Sara + Kevin Russell, Austin real estate agents at Compass."
>
  <!-- Page hero -->
  <section class="relative flex items-end overflow-hidden bg-ink">
    <img
      src="/hero-austin.jpg"
      alt="Austin, Texas skyline"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/60 to-ink"></div>
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-48 pb-16 lg:px-10">
      <p class="text-xs font-medium tracking-[0.35em] text-gold-light uppercase">Neighborhood Guide</p>
      <h1 class="mt-4 font-serif text-5xl text-white md:text-7xl">Explore Austin</h1>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-white/70 md:text-base">
        We've curated some of the best of what different parts of ATX have to offer. You start
        and end each day in your neighborhood — so why not find a spot that you love?
      </p>
      <ContactButton
        label="Let's Connect"
        class="mt-8 bg-gold px-8 py-3.5 text-xs font-medium tracking-[0.25em] text-white uppercase transition-colors hover:bg-gold-light"
      />
    </div>
  </section>

  <!-- Neighborhoods -->
  <section class="bg-cream">
    <div class="mx-auto max-w-7xl space-y-24 px-6 py-24 lg:px-10">
      {
        neighborhoods.map((hood, i) => (
          <article class="grid items-center gap-12 lg:grid-cols-2">
            <div class:list={["overflow-hidden", i % 2 === 1 && "lg:order-2"]}>
              <img
                src={hood.image}
                alt={`${hood.name}, Austin`}
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
            <div class:list={[i % 2 === 1 && "lg:order-1"]}>
              <p class="text-xs font-medium tracking-[0.3em] text-gold uppercase">{hood.region}</p>
              <h2 class="mt-3 font-serif text-4xl md:text-5xl">{hood.name}</h2>
              <p class="mt-6 text-sm leading-relaxed text-ink/70 md:text-base">{hood.description}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink/70 md:text-base">{hood.housing}</p>
              <ul class="mt-6 space-y-2">
                {hood.facts.map((fact) => (
                  <li class="flex items-center gap-3 text-sm text-ink/80">
                    <span class="h-px w-6 bg-gold" aria-hidden="true" />
                    {fact}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
